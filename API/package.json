{
  "name": "api-cozinha",
  "version": "2.0.0",
  "private": true,
  "description": "API do Sistema de Cozinha da ETEC Bento Quirino",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "sequelize-cli db:migrate && node server.js",
    "dev": "sequelize-cli db:migrate && node --watch server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "8.16.3",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "socket.io": "4.8.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "sqlite3": "6.0.1",
    "supertest": "7.1.4",
    "vitest": "^4.1.11"
  }
}
